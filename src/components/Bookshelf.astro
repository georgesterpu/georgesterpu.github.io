---
import {
  publishedBooks,
  bookUrl,
  hasBookNotes,
  readingShelves,
  shelfLabel,
} from '../lib/content';
import Arrow from './Arrow.astro';
interface Props {
  list: string;
}
const { list } = Astro.props;
const books = (await publishedBooks()).filter(
  (book) => book.data.list.id === list,
);
const shelves = await readingShelves();
const groups = [
  {
    status: 'read',
    title:
      list === 'business-books' ? 'Business books reading list' : 'Books read',
    id:
      list === 'business-books' ? 'business-books-reading-list' : 'books-read',
  },
  { status: 'in-progress', title: 'In progress', id: 'in-progress' },
  { status: 'on-shelf', title: 'On the shelf', id: 'on-the-shelf' },
];
---

<div class="shelf-nav">
  <a href="/books/">
    The bookshelf <span aria-hidden="true">↗</span>
  </a>
  <nav aria-label="Reading lists">
    {shelves.map((shelf) => (
      <a
        href={`/posts/${shelf.id}/`}
        aria-current={shelf.id === list ? 'page' : undefined}
      >
        {shelfLabel(shelf.data.title)}
      </a>
    ))}
  </nav>
</div>
<div class="shelf-controls" data-book-controls hidden>
  <label class="search-label">
    <span class="sr-only">Search books by title or author</span>
    <input
      type="search"
      data-book-search
      placeholder="Find a book or author…"
      autocomplete="off"
    />
  </label>
  <p class="mono" data-book-count aria-live="polite" aria-atomic="true">
    {books.length} books
  </p>
</div>
{groups.map((group) => {
  const entries = books.filter((book) => book.data.status === group.status);
  return (
    entries.length > 0 && (
      <section class="shelf-group" data-book-group aria-labelledby={group.id}>
        <div class="shelf-group-heading">
          <h2 id={group.id}>{group.title}</h2>
        </div>
        <ul class="book-grid">
          {entries.map((book) => (
            <li
              class="book-card"
              data-book
              data-search={`${book.data.title} ${book.data.author}`.toLowerCase()}
              id={`book-${book.data.position}`}
            >
              <div class="book-cover-stage">
                {hasBookNotes(book) ? (
                  <a
                    href={bookUrl(book)}
                    aria-label={`Read saved passages from ${book.data.title}`}
                  >
                    <img
                      src={book.data.cover}
                      width="300"
                      height="450"
                      alt={`Cover of ${book.data.title}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                ) : (
                  <img
                    src={book.data.cover}
                    width="300"
                    height="450"
                    alt={`Cover of ${book.data.title}`}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
              <p class="book-position mono">
                {String(book.data.position).padStart(2, '0')}
              </p>
              <h3>
                {hasBookNotes(book) ? (
                  <a href={bookUrl(book)}>{book.data.title}</a>
                ) : (
                  book.data.title
                )}
              </h3>
              <p class="book-author">{book.data.author}</p>
              {hasBookNotes(book) && (
                <a class="text-link book-notes-link" href={bookUrl(book)}>
                  Saved passages <Arrow />
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  );
})}
<p class="empty-state" data-book-empty hidden>
  No books match. Try another title or author.
</p>
<script>
  const controls = document.querySelector<HTMLElement>('[data-book-controls]');
  const search = document.querySelector<HTMLInputElement>('[data-book-search]');
  const cards = document.querySelectorAll<HTMLElement>('[data-book]');
  const groups = document.querySelectorAll<HTMLElement>('[data-book-group]');
  const count = document.querySelector('[data-book-count]');
  const empty = document.querySelector<HTMLElement>('[data-book-empty]');
  if (controls) controls.hidden = false;
  search?.addEventListener('input', () => {
    const query = search.value.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      card.hidden = !(card.dataset.search ?? '').includes(query);
      if (!card.hidden) visible++;
    }
    for (const group of groups)
      group.hidden = ![
        ...group.querySelectorAll<HTMLElement>('[data-book]'),
      ].some((card) => !card.hidden);
    if (count)
      count.textContent = `${visible} ${visible === 1 ? 'book' : 'books'}`;
    if (empty) empty.hidden = visible !== 0;
  });
</script>
