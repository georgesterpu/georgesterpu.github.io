---
import { render, type CollectionEntry } from 'astro:content';
import { selectedWork } from '../../lib/content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import profile from '../../data/profile.json';
export async function getStaticPaths() {
  return (await selectedWork()).map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}
interface Props {
  item: CollectionEntry<'work'>;
}
const { item } = Astro.props;
const { Content } = await render(item);
---

<SiteLayout title={item.data.title} description={item.data.description} article>
  <div class="article-shell">
    <a class="back-link" href="/work/">
      ← Selected work
    </a>
    <header class="article-heading">
      <p class="eyebrow">
        {item.data.company} / {item.data.period}
      </p>
      <h1>{item.data.title}</h1>
      <p class="article-deck">{item.data.description}</p>
      <div class="tag-list">
        {item.data.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <aside class="article-end">
      <p>Want to talk about a similar challenge?</p>
      <a class="text-link" href={`mailto:${profile.email}`}>
        Get in touch <span aria-hidden="true">↗</span>
      </a>
    </aside>
  </div>
</SiteLayout>
