---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found">
  <header class="page-heading">
    <p class="eyebrow">404 / A wrong turn</p>
    <h1>
      Let’s get you
      <br />
      <em>back on track.</em>
    </h1>
    <p>
      This page doesn’t exist. The writing archive is a good place to look for
      an older post.
    </p>
    <div class="hero-actions">
      <a class="button" href="/">
        Back home →
      </a>
      <a class="text-link" href="/archives/">
        Browse the archive →
      </a>
    </div>
  </header>
</SiteLayout>
