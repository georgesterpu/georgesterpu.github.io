---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import profile from '../data/profile.json';
import { formatDate, postUrl, publishedPosts } from '../lib/content';

const posts = await publishedPosts();
const notebook = [
  {
    id: 'ferris_questions',
    label: 'Reflections',
    summary: 'Reflections on learning, community, and what matters.',
  },
  {
    id: 'reading-list-2025',
    label: 'Reading list',
    summary: 'Books on products, communication, AI and other ideas.',
  },
].flatMap((selection) => {
  const post = posts.find(
    (post) => post.id === selection.id && !post.data.archived,
  );
  return post ? [{ ...selection, post }] : [];
});
---

<SiteLayout>
  <div class="notebook-home">
    <section class="notebook-hero" aria-labelledby="intro-title">
      <p class="eyebrow">AI engineer · {profile.location}</p>
      <h1 id="intro-title">
        {profile.headline.lead} <em>{profile.headline.emphasis}</em>
      </h1>
      <p class="notebook-intro">{profile.intro}</p>
      <div class="notebook-actions">
        <a class="button" href="#writing">
          Read the notebook <Arrow />
        </a>
        <a class="text-link" href="#projects">
          How I approach work <Arrow />
        </a>
      </div>
      <img
        class="notebook-portrait"
        src="/img/profile_pic.jpg"
        width="800"
        height="800"
        alt="George Sterpu"
        fetchpriority="high"
      />
    </section>

    <section
      id="writing"
      class="notebook-section"
      aria-labelledby="writing-title"
    >
      <div class="notebook-heading">
        <div>
          <p class="eyebrow">01 / Writing & reading</p>
          <h2 id="writing-title">From the notebook.</h2>
        </div>
        <a class="text-link" href="/writing/">
          All writing <Arrow />
        </a>
      </div>
      <p class="notebook-section-intro">
        A few things I've written down, from changing my mind to keeping track
        of books.
      </p>
      <div class="notebook-entries">
        {notebook.map(({ post, label, summary }) => (
          <article class="notebook-entry">
            <div class="notebook-entry-meta">
              <span>{label}</span>
              <time datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
            </div>
            <div>
              <h3>
                <a href={postUrl(post)}>
                  {post.data.title}
                  <Arrow />
                </a>
              </h3>
              <p>{summary}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section
      id="projects"
      class="notebook-section notebook-work"
      aria-labelledby="projects-title"
    >
      <div class="notebook-heading">
        <div>
          <p class="eyebrow">02 / Work</p>
          <h2 id="projects-title">How I work.</h2>
        </div>
        <a class="text-link" href="/work/">
          Background and earlier work <Arrow />
        </a>
      </div>
      <p class="notebook-work-summary">
        I work across AI research, engineering and business problems. My
        background spans a doctorate in speech and multimodal learning, deep
        learning on small devices, and building automation. I bring a research
        mindset to practical work: understand what people need, test the
        assumptions, and carry an idea through to something they can use.
      </p>
    </section>

    <section
      class="notebook-section notebook-outside"
      aria-labelledby="outside-title"
    >
      <div>
        <p class="eyebrow">03 / Outside work</p>
        <h2 id="outside-title">Running and reading.</h2>
        <p>
          I've kept a photo journal of races and runs, and a bookshelf of
          reading lists and notes. They're both here if you'd like a look.
        </p>
        <div class="notebook-actions">
          <a class="text-link" href="/posts/running/">
            Running journal <Arrow />
          </a>
          <a class="text-link" href="/books/">
            Bookshelf <Arrow />
          </a>
        </div>
      </div>
      <figure>
        <a
          href="/posts/running/#glenmore-marathon-louth-june-7-2025"
          aria-label="Glenmore Marathon in the running journal"
        >
          <img
            src="/img/running/glenmore.jpg"
            width="1600"
            height="900"
            alt="Runners gathered on the road at the start of the Glenmore Marathon"
            loading="lazy"
          />
        </a>
        <figcaption>Glenmore Marathon, Louth · 7 June 2025</figcaption>
      </figure>
    </section>

    <section
      id="contact"
      class="notebook-section notebook-contact"
      aria-labelledby="contact-title"
    >
      <p class="eyebrow">04 / A note back</p>
      <h2 id="contact-title">Say hello.</h2>
      <p>
        Have a question, a correction, or a good book recommendation? Send me a
        note.
      </p>
      <div class="notebook-actions">
        <a class="text-link" href={`mailto:${profile.email}`}>
          Email me <Arrow />
        </a>
        <a class="text-link" href={profile.linkedin}>
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>
</SiteLayout>
