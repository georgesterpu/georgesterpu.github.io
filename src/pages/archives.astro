---
import SiteLayout from '../layouts/SiteLayout.astro';
import PostList from '../components/PostList.astro';
import { publishedPosts } from '../lib/content';
const posts = await publishedPosts();
const years = [
  ...new Set(posts.map((post) => post.data.date.getUTCFullYear())),
];
---

<SiteLayout title="Archive">
  <header class="page-heading">
    <p class="eyebrow">The whole notebook</p>
    <h1>
      The <em>archive.</em>
    </h1>
    <p>Every entry, including the earliest hello.</p>
  </header>
  {years.map((year) => (
    <section class="archive-year">
      <h2>{year}</h2>
      <PostList
        posts={posts.filter((post) => post.data.date.getUTCFullYear() === year)}
        headingLevel={3}
      />
    </section>
  ))}
</SiteLayout>
